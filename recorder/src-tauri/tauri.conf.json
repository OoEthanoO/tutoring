{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YanLearn Recorder",
  "version": "0.4.0",
  "identifier": "com.yanlearn.recorder",
  "build": {
    "frontendDist": "../src"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OoEthanoO/tutoring/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NzIwNTI2NzIzN0NFNTkKUldSWnpqZHlKZ1Z5eGJFaHVrWG9OMW03a05Qb0ZKZ1c4dkhMMng5bnQ5QjMyUnFtS2wrMVJ0WngK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "YanLearn Recorder",
        "width": 480,
        "height": 680,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "contentProtected": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
